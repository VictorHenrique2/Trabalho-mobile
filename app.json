          <ProfileItem label="OBJETIVO" value="Ganhar massa muscular" />
          <ProfileItem label="NÍVEL" value="Intermediário" />
          <ProfileItem label="TREINOS POR SEMANA" value="5 dias" />
          <ProfileItem label="ALTURA" value="1,75 m" />
          <ProfileItem label="PESO" value="75 kg" />

          <TouchableOpacity
            style={styles.fullGreenButton}
            onPress={() =>
              Alert.alert(
                "Em breve",
                "A edição do perfil será adicionada."
              )
            }
          >
            <Text style={styles.fullGreenText}>
              EDITAR PERFIL
            </Text>
          </TouchableOpacity>
        </ScrollView>
      </SafeAreaView>
    );
  }

  function BottomNav() {
    return (
      <View style={styles.bottomNav}>
        <NavItem
          icon="🏠"
          label="INÍCIO"
          active={screen === "home"}
          onPress={() => setScreen("home")}
        />

        <NavItem
          icon="🏋️"
          label="TREINO"
          active={screen === "workout"}
          onPress={() => setScreen("workout")}
        />

        <NavItem
          icon="🥗"
          label="DIETA"
          active={screen === "diet"}
          onPress={() => setScreen("diet")}
        />

        <NavItem
          icon="👤"
          label="PERFIL"
          active={screen === "profile"}
          onPress={() => setScreen("profile")}
        />
      </View>
    );
  }

  if (screen === "analysis") return <AnalysisScreen />;
  if (screen === "workout") return <WorkoutScreen />;
  if (screen === "diet") return <DietScreen />;
  if (screen === "ai") return <AIScreen />;
  if (screen === "profile") return <ProfileScreen />;

  return <HomeScreen />;
}

function Macro({ value, label, color }) {
  return (
    <View style={styles.macro}>
      <Text style={[styles.macroValue, { color }]}>
        {value}
      </Text>
      <Text style={styles.macroLabel}>{label}</Text>
    </View>
  );
}

function FoodItem({ emoji, name, calories }) {
  return (
    <View style={styles.foodItem}>
      <Text style={styles.foodEmoji}>{emoji}</Text>

      <View style={{ flex: 1 }}>
        <Text style={styles.foodName}>{name}</Text>
        <Text style={styles.foodCalories}>{calories}</Text>
      </View>

      <Text style={styles.check}>✓</Text>
    </View>
  );
}

function Exercise({
  number,
  name,
  sets,
  reps,
  done,
}) {
  return (
    <View style={styles.exercise}>
      <View style={styles.exerciseNumber}>
        <Text style={styles.exerciseNumberText}>
          {number}
        </Text>
      </View>

      <View style={{ flex: 1 }}>
        <Text style={styles.exerciseName}>{name}</Text>
        <Text style={styles.exerciseDetails}>
          {sets} • {reps}
        </Text>
      </View>

      <View
        style={[
          styles.exerciseCheck,
          done && styles.exerciseCheckDone,
        ]}
      >
        <Text style={styles.exerciseCheckText}>
          {done ? "✓" : ""}
        </Text>
      </View>
    </View>
  );
}

function Meal({
  time,
  emoji,
  title,
  description,
  calories,
}) {
  return (
    <View style={styles.meal}>
      <Text style={styles.mealTime}>{time}</Text>

      <View style={styles.mealIcon}>
        <Text>{emoji}</Text>
      </View>

      <View style={{ flex: 1 }}>
        <Text style={styles.mealTitle}>{title}</Text>
        <Text style={styles.mealDescription}>
          {description}
        </Text>
      </View>

      <Text style={styles.mealCalories}>{calories}</Text>
    </View>
  );
}

function ProfileItem({ label, value }) {
  return (
    <View style={styles.profileItem}>
      <Text style={styles.profileLabel}>{label}</Text>
      <Text style={styles.profileValue}>{value}</Text>
    </View>
  );
}

function NavItem({
  icon,
  label,
  active,
  onPress,
}) {
  return (
    <TouchableOpacity
      style={styles.navItem}
      onPress={onPress}
    >
      <Text
        style={[
          styles.navIcon,
          active && styles.navIconActive,
        ]}
      >
        {icon}
      </Text>

      <Text
        style={[
          styles.navLabel,
          active && styles.navLabelActive,
        ]}
      >
        {label}
      </Text>
    </TouchableOpacity>
  );
}

