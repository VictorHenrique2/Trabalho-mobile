          <Exercise
            number="02"
            name="Supino inclinado"
            sets="3 séries"
            reps="10–12 repetições"
            done={true}
          />

          <Exercise
            number="03"
            name="Crucifixo"
            sets="3 séries"
            reps="12–15 repetições"
