          <TouchableOpacity
            style={styles.fullGreenButton}
            onPress={() =>
              Alert.alert(
                "Treino iniciado!",
                "Boa sorte! Vamos começar seu treino."
              )
            }
          >
            <Text style={styles.fullGreenText}>
              ▶ COMEÇAR TREINO
            </Text>
          </TouchableOpacity>

          <TouchableOpacity
            style={styles.aiGenerate}
            onPress={() => setScreen("ai")}
          >
            <Text style={styles.aiGenerateIcon}>🤖</Text>
            <View style={{ flex: 1 }}>
              <Text style={styles.aiGenerateTitle}>
                CRIAR NOVO TREINO
              </Text>
              <Text style={styles.aiGenerateText}>
                Deixe a IA montar um treino personalizado
              </Text>
            </View>
            <Text style={styles.arrow}>→</Text>
          </TouchableOpacity>
        </ScrollView>
      </SafeAreaView>
    );
  }

  function DietScreen() {
    return (
      <SafeAreaView style={styles.safe}>
        <Header title="MINHA DIETA" />

        <ScrollView
          contentContainerStyle={styles.container}
          showsVerticalScrollIndicator={false}
        >
          <View style={styles.dietSummary}>
            <Text style={styles.daySmall}>META DIÁRIA</Text>
            <Text style={styles.dietCalories}>2.200 kcal</Text>

            <View style={styles.progressBar}>
              <View
                style={[styles.progressFill, { width: "62%" }]}
              />
            </View>

            <Text style={styles.progressText}>
              1.364 kcal consumidas
            </Text>
          </View>

          <Text style={styles.sectionTitle}>SUAS REFEIÇÕES</Text>

          <Meal
            time="07:30"
            emoji="🍳"
            title="CAFÉ DA MANHÃ"
            description="Ovos + aveia + banana"
            calories="420 kcal"
          />

          <Meal
            time="12:30"
            emoji="🍗"
            title="ALMOÇO"
            description="Frango + arroz + feijão + salada"
            calories="587 kcal"
          />

          <Meal
            time="16:00"
            emoji="🥛"
            title="LANCHE"
            description="Iogurte + fruta + aveia"
            calories="280 kcal"
          />

          <Meal
            time="20:00"
            emoji="🥗"
            title="JANTAR"
            description="Proteína + vegetais + carboidrato"
            calories="510 kcal"
          />

          <TouchableOpacity
            style={styles.aiGenerate}
            onPress={() => setScreen("ai")}
          >
            <Text style={styles.aiGenerateIcon}>🤖</Text>

            <View style={{ flex: 1 }}>
              <Text style={styles.aiGenerateTitle}>
                PERSONALIZAR DIETA
              </Text>

              <Text style={styles.aiGenerateText}>
                Peça para a IA alterar seu plano
              </Text>
            </View>

            <Text style={styles.arrow}>→</Text>
          </TouchableOpacity>
        </ScrollView>
      </SafeAreaView>
    );
  }

  function AIScreen() {
    const [messages, setMessages] = useState([
      {
        from: "ai",
        text: "Olá! Eu sou a IA do ALFA FIT. Posso ajudar com seu treino e alimentação. O que você precisa?",
      },
    ]);

    function quickMessage(text) {
      setMessages((old) => [
        ...old,
        { from: "user", text },
        {
          from: "ai",
          text:
            "Perfeito! Na próxima etapa vou conectar esta conversa à IA real para criar uma resposta personalizada para você.",
        },
      ]);
    }

    return (
      <SafeAreaView style={styles.safe}>
        <Header title="ALFA IA" />

        <ScrollView
          contentContainerStyle={styles.container}
          showsVerticalScrollIndicator={false}
        >
          <View style={styles.aiHero}>
            <View style={styles.aiCircle}>
              <Text style={styles.aiRobot}>🤖</Text>
            </View>

            <Text style={styles.aiHeroTitle}>
              SEU TREINADOR INTELIGENTE
            </Text>

            <Text style={styles.aiHeroText}>
              Monte treinos e organize sua alimentação com
              inteligência artificial.
            </Text>
          </View>

          {messages.map((message, index) => (
            <View
              key={index}
              style={[
                styles.message,
                message.from === "user"
                  ? styles.userMessage
                  : styles.aiMessage,
              ]}
            >
              <Text
                style={
                  message.from === "user"
                    ? styles.userMessageText
                    : styles.aiMessageText
                }
              >
                {message.text}
              </Text>
            </View>
          ))}

          <Text style={styles.sectionTitle}>
            O QUE VOCÊ QUER FAZER?
          </Text>

          <TouchableOpacity
            style={styles.aiOption}
            onPress={() =>
              quickMessage("Monte um treino para mim")
            }
          >
            <Text style={styles.aiOptionIcon}>🏋️</Text>
            <Text style={styles.aiOptionText}>
              MONTE MEU TREINO
            </Text>
          </TouchableOpacity>

          <TouchableOpacity
            style={styles.aiOption}
            onPress={() =>
              quickMessage("Monte um plano alimentar para mim")
            }
          >
            <Text style={styles.aiOptionIcon}>🥗</Text>
            <Text style={styles.aiOptionText}>
              MONTE MINHA DIETA
            </Text>
          </TouchableOpacity>

          <TouchableOpacity
            style={styles.aiOption}
            onPress={() =>
              quickMessage(
                "Quero adaptar meu treino para hoje"
              )
            }
          >
            <Text style={styles.aiOptionIcon}>⚡</Text>
            <Text style={styles.aiOptionText}>
              ADAPTAR MEU TREINO
            </Text>
          </TouchableOpacity>

          <TouchableOpacity
            style={styles.aiOption}
            onPress={() =>
              quickMessage(
                "Quero saber como melhorar minha alimentação"
