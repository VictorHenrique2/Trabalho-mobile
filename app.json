            </Text>
            <Text style={styles.estimated}>
              ESTIMATIVA DA IA
            </Text>
          </View>

          <View style={styles.calorieBox}>
            <Text style={styles.calorieNumber}>587</Text>
            <Text style={styles.calorieText}>KCAL</Text>
          </View>

          <View style={styles.macros}>
            <Macro
              value="43g"
              label="PROTEÍNAS"
              color={GREEN}
            />

            <Macro
              value="61g"
              label="CARBOIDRATOS"
              color="#00D9FF"
            />

            <Macro
              value="16g"
              label="GORDURAS"
              color="#FFB800"
            />
          </View>

          <Text style={styles.sectionTitle}>
            ALIMENTOS IDENTIFICADOS
          </Text>

          <FoodItem
            emoji="🍗"
            name="Frango grelhado"
            calories="280 kcal"
          />

          <FoodItem
            emoji="🍚"
            name="Arroz"
            calories="190 kcal"
          />

          <FoodItem
            emoji="🫘"
            name="Feijão"
            calories="72 kcal"
          />

          <FoodItem
            emoji="🥗"
            name="Salada"
            calories="45 kcal"
          />

          <View style={styles.warning}>
            <Text style={styles.warningText}>
