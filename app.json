          </View>

          <TouchableOpacity
            style={styles.chatButton}
            onPress={() => setScreen("ai")}
          >
            <Text style={styles.chatIcon}>🤖</Text>

            <View style={{ flex: 1 }}>
              <Text style={styles.chatTitle}>FALAR COM A IA</Text>
              <Text style={styles.chatDescription}>
                Tire suas dúvidas e personalize seu plano
              </Text>
            </View>

            <Text style={styles.arrow}>→</Text>
          </TouchableOpacity>

          <View style={styles.tipCard}>
            <Text style={styles.tipTitle}>⚡ DICA DO ALFA FIT</Text>
            <Text style={styles.tipText}>
              Pequenas mudanças feitas todos os dias geram grandes
