import React, { useState } from "react";
import {
  SafeAreaView,
  View,
  Text,
  StyleSheet,
  TouchableOpacity,
  ScrollView,
  StatusBar,
  Alert,
  Image,
} from "react-native";
import * as ImagePicker from "expo-image-picker";

const GREEN = "#39FF14";
const DARK = "#050505";
const CARD = "#101410";
const WHITE = "#FFFFFF";
const GRAY = "#9CA3AF";

export default function App() {
  const [screen, setScreen] = useState("home");
  const [mealImage, setMealImage] = useState(null);

  async function takeMealPhoto() {
    const permission =
      await ImagePicker.requestCameraPermissionsAsync();

    if (!permission.granted) {
      Alert.alert(
        "Permissão necessária",
        "Precisamos da câmera para analisar seu prato."
      );
      return;
    }

    const result = await ImagePicker.launchCameraAsync({
      mediaTypes: ["images"],
      quality: 0.8,
      allowsEditing: true,
    });

    if (!result.canceled) {
      setMealImage(result.assets[0].uri);
      setScreen("analysis");
    }
  }

  function Header({ title, back = true }) {
    return (
      <View style={styles.header}>
        {back ? (
          <TouchableOpacity
            style={styles.backButton}
            onPress={() => setScreen("home")}
          >
            <Text style={styles.backText}>‹</Text>
          </TouchableOpacity>
        ) : (
          <View style={{ width: 42 }} />
        )}

        <Text style={styles.headerTitle}>{title}</Text>

        <View style={{ width: 42 }} />
      </View>
    );
  }

  function HomeScreen() {
    return (
      <SafeAreaView style={styles.safe}>
        <ScrollView
          contentContainerStyle={styles.container}
          showsVerticalScrollIndicator={false}
        >
          <View style={styles.topBar}>
            <View>
              <Text style={styles.logo}>ALFA FIT</Text>
              <Text style={styles.subtitle}>FITNESS • NUTRIÇÃO • IA</Text>
            </View>

            <TouchableOpacity style={styles.notification}>
              <Text style={styles.notificationText}>🔔</Text>
            </TouchableOpacity>
          </View>

          <View style={styles.greeting}>
            <Text style={styles.hello}>OLÁ, ATLETA! 👋</Text>
            <Text style={styles.question}>Pronto para evoluir?</Text>
          </View>

          <TouchableOpacity
            style={styles.mainAI}
            onPress={takeMealPhoto}
            activeOpacity={0.85}
          >
            <View style={styles.glowCircle}>
              <Text style={styles.cameraIcon}>📸</Text>
            </View>

            <Text style={styles.mainAITitle}>
              ANALISAR MEU PRATO
            </Text>

            <Text style={styles.mainAIDescription}>
              Tire uma foto e descubra calorias e nutrientes com IA
            </Text>

            <View style={styles.greenButton}>
              <Text style={styles.greenButtonText}>
                ANALISAR AGORA →
              </Text>
            </View>
          </TouchableOpacity>

          <Text style={styles.sectionTitle}>SEU PROGRESSO</Text>

          <View style={styles.progressRow}>
            <View style={styles.progressCard}>
              <Text style={styles.progressIcon}>🔥</Text>
              <Text style={styles.progressNumber}>7</Text>
              <Text style={styles.progressLabel}>DIAS</Text>
            </View>

            <View style={styles.progressCard}>
              <Text style={styles.progressIcon}>🏋️</Text>
              <Text style={styles.progressNumber}>12</Text>
              <Text style={styles.progressLabel}>TREINOS</Text>
            </View>

            <View style={styles.progressCard}>
              <Text style={styles.progressIcon}>🎯</Text>
              <Text style={styles.progressNumber}>84%</Text>
              <Text style={styles.progressLabel}>META</Text>
